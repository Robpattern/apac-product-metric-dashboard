# Copy to .env.local for local dev. In production set these in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# ClickUp personal API token. ClickUp → Settings → Apps → API Token.
# Server-side only: it is read in app/api/tickets/route.js and never reaches the browser.
CLICKUP_API_TOKEN=

# Optional. If set, POST /api/promote requires header  x-triage-secret: <this value>
TRIAGE_SHARED_SECRET=
